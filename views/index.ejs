<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TerraFlag — World Flag Expedition</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;700;800&family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>

<body id="app">
  <!-- Subtle ambient decorative glow elements -->
  <div class="ambient-glow glow-top" aria-hidden="true"></div>
  <div class="ambient-glow glow-bottom" aria-hidden="true"></div>
  <div class="bg-grid-overlay" aria-hidden="true"></div>

  <main class="quiz-shell">
    <% if (locals.wasCorrect === false) { %>
      <!-- Game Over / Post-Run Screen -->
      <section class="game-card game-over-view" aria-labelledby="game-over-title">
        <div class="card-status-bar status-failed">
          <span class="status-pulse-dot red"></span>
          <span class="status-label">EXPEDITION TERMINATED</span>
        </div>

        <div class="result-crest">
          <div class="crest-halo"></div>
          <div class="crest-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
          </div>
        </div>

        <div class="game-over-content">
          <h1 id="game-over-title" class="display-title">Incorrect Match</h1>
          <p class="display-subtitle">Your territory exploration streak came to an end. Ready for another run?</p>
        </div>

        <div class="score-monolith">
          <div class="score-metric">
            <span class="metric-caption">FINAL STREAK SCORE</span>
            <div class="metric-number"><%= locals.totalScore ? totalScore : 0 %></div>
          </div>
          <div class="score-rating">
            <% const finalScore = Number(locals.totalScore || 0); %>
            <% if (finalScore >= 15) { %>
              <span class="rating-badge rank-gold">★ Master Geographer</span>
            <% } else if (finalScore >= 8) { %>
              <span class="rating-badge rank-silver">◆ Global Navigator</span>
            <% } else if (finalScore >= 3) { %>
              <span class="rating-badge rank-bronze">● Explorer</span>
            <% } else { %>
              <span class="rating-badge rank-novice">○ Novice Scout</span>
            <% } %>
          </div>
        </div>

        <div class="action-footer">
          <a href="/" class="primary-btn replay-btn">
            <span>START NEW RUN</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.19"/>
            </svg>
          </a>
        </div>
      </section>

    <% } else { %>
      <!-- Active Quiz Card -->
      <form class="game-card quiz-view <%= locals.wasCorrect === true ? 'card-success-pulse' : '' %>" action="/submit" method="post" autocomplete="off">
        
        <!-- Header: Mission tag & Live score tracker -->
        <header class="card-header">
          <div class="brand-pill">
            <svg class="brand-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="brand-text">TERRAFLAG</span>
          </div>

          <div class="score-counter-pill" title="Current Score Streak">
            <span class="score-led"></span>
            <span class="score-tag">SCORE</span>
            <span id="score" class="score-digit"><%= locals.totalScore ? totalScore : "0" %></span>
          </div>
        </header>

        <!-- Flag Artifact Display Container -->
        <div class="flag-showcase">
          <div class="flag-pedestal">
            <div class="pedestal-shine"></div>
            <div class="flag-display" id="countryFlag" aria-label="Flag to identify">
              <%= question && question.flag ? question.flag : "🏳️" %>
            </div>
          </div>

          <div class="prompt-group">
            <span class="prompt-kicker">IDENTIFY NATION</span>
            <h2 class="prompt-text">Which country flies this flag?</h2>
          </div>
        </div>

        <!-- Submission Command Bar -->
        <div class="submission-dock">
          <div class="input-housing">
            <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="text" 
              name="answer" 
              id="userInput" 
              placeholder="Type country name..." 
              autofocus 
              autocomplete="off"
              spellcheck="false"
              required
            >
            <kbd class="key-hint" aria-hidden="true">↵</kbd>
          </div>

          <button type="submit" class="primary-btn submit-trigger" id="submitBtn">
            <span class="btn-label">CONFIRM GUESS</span>
            <% if (locals.wasCorrect === true) { %>
              <span class="btn-match-badge" title="Correct Match!">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>MATCH</span>
              </span>
            <% } else { %>
              <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            <% } %>
          </button>
        </div>

      </form>
    <% } %>
  </main>
</body>

</html>